# HTTP server bind address
HTTP_ADDR=:8080

# PostgreSQL connection string for running the app locally (without Docker)
DATABASE_URL=postgres://social:social@localhost:5432/social?sslmode=disable

# Comma-separated replica DSNs (empty: all reads go to the primary)
DATABASE_REPLICA_URLS=

# Maximum PostgreSQL connections in the application pool
DB_MAX_CONNS=16

# Log one line per HTTP request (disable during load tests)
LOG_REQUESTS=true

# Read fallback to the primary when a replica lags behind a write
READ_FALLBACK_TO_MASTER=true

# Redis: feed cache, friend cache, post cache and the fan-out queue
REDIS_URL=redis://localhost:6379/0

# Feed size and TTLs (ДЗ-4)
FEED_SIZE=1000
FEED_CACHE_TTL=10m
FRIENDS_CACHE_TTL=10m
POST_CACHE_TTL=1h
FEED_INCLUDE_OWN=true

# sync — fan-out inside the write request (default, read-your-writes);
# queue — fan-out jobs in Redis Streams, processed by background workers
FEED_FANOUT_MODE=sync
FEED_WORKERS=2

# Test/admin API: /test/*, /admin/feed/*
ENABLE_TEST_API=true
